{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pandas3_full/conventions/schema/task.schema.json",
 "title": "Study task (one tasks/<PKG>/<task_id>/task.json)",
 "$comment": "Written 2026-11-11 by pkg:SHARED. Implements FULL_PREREG sections 3, 4.3, 4.4, 5, 10.1. Only the schema subset implemented by harness/validate_tasks.py is used (type, enum, const, pattern, required, properties, additionalProperties, items, minItems, maxItems, minLength, minimum, maximum, anyOf, $ref). Cross-field rules (per-stratum required fields, sort_keys iff order_significant, row_order vs order_significant, property-check argument types, id vs family) are enforced in validate_tasks.py and listed in conventions/CONVENTIONS.md section 5.",
 "type": "object",
 "additionalProperties": false,
 "required": ["id", "stratum", "family", "generic_family", "catalogue_row", "files", "task_text", "allowed_task_words",
              "invited_ids_author", "order_significant", "sort_keys", "dtype_significant", "intended_computation",
              "acceptable_variants", "property_checks", "predicted_direction", "naive_path", "reference_path",
              "drafted_by", "status"],
 "properties": {
  "id": {"type": "string",
         "pattern": "^(M_QF[1-8]_(0[1-9]|1[0-6])|R_(0[1-9]|[1-3][0-9]|40)|A_(TXT|IMP|CONV|BIN|DATE|TS|TOP|MRG|PIV|ENC|UPD|RPT)_[0-9]{2}|EX_[A-Z0-9]+_[0-9]{2})$",
         "description": "M_<QFn>_<nn> (nn 01-16), R_<nn> (selection order, 01-40), A_<FAM>_<nn>; EX_* only for fictitious examples (rejected in study mode)"},
  "stratum": {"enum": ["M", "R", "A"]},
  "family": {"anyOf": [{"type": "null"},
                       {"enum": ["QF1_STRING", "QF2_DATETIME", "QF3_COW", "QF4_GROUPBY", "QF5_ORDER", "QF6_NA_DTYPE",
                                 "QF7_INDEX_REDUCE", "QF8_NUMERIC"]}],
             "description": "quota family (required for M, null for R and A)"},
  "generic_family": {"anyOf": [{"type": "null"},
                               {"enum": ["TXT", "IMP", "CONV", "BIN", "DATE", "TS", "TOP", "MRG", "PIV", "ENC", "UPD", "RPT"]}],
                     "description": "pilot generic family (required for A, optional for R, null for M)"},
  "catalogue_row": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/catalogue_id"}],
                    "description": "M only: the confirmed catalogue row whose quota slot this task fills (quota_allocation.tsv); must be in invited_ids_author"},
  "files": {"type": "array", "minItems": 1, "maxItems": 4,
            "items": {"type": "object", "additionalProperties": false, "required": ["path", "description"],
                      "properties": {
                       "path": {"type": "string", "pattern": "^(QF[1-8]_[A-Z_]+|GEN)/[a-z0-9][a-z0-9_\\-]*\\.csv$",
                                "description": "relative to fixtures/<variant>/ (main, clean, dirty)"},
                       "description": {"type": "string", "minLength": 10,
                                       "description": "the F-main line of fixtures/descriptions.tsv for this file, verbatim"}}}},
  "task_text": {"type": "string", "minLength": 20},
  "allowed_task_words": {"type": "array", "items": {"type": "string", "minLength": 1}},
  "invited_ids_author": {"type": "array", "items": {"$ref": "#/$defs/catalogue_id"}},
  "order_significant": {"type": "boolean"},
  "sort_keys": {"type": "array", "items": {"type": "string", "minLength": 1},
                "description": "non-empty iff order_significant; key(s) named by the task text, in sort priority order"},
  "dtype_significant": {"type": "boolean"},
  "intended_computation": {"type": "string", "minLength": 20},
  "acceptable_variants": {
   "type": "object", "additionalProperties": false,
   "required": ["row_order", "label_spelling", "missing_value_representation", "rounding_sig_digits", "notes"],
   "properties": {
    "row_order": {"enum": ["any", "ties_only"], "description": "'any' unless order_significant, then 'ties_only'"},
    "label_spelling": {"type": "boolean", "description": "true: label case/space/underscore differences are acceptable"},
    "missing_value_representation": {"type": "boolean", "description": "true: NaN/None/pd.NA/NaT/empty are interchangeable"},
    "rounding_sig_digits": {"type": "integer", "minimum": 1, "maximum": 15, "description": "6 by default (section 10.1)"},
    "notes": {"type": "string"}}},
  "property_checks": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/property_check"}},
  "predicted_direction": {
   "anyOf": [{"type": "null"},
             {"type": "object", "additionalProperties": false, "required": ["direction", "reason"],
              "properties": {"direction": {"enum": ["HARM", "FIX", "BOTH"]}, "reason": {"type": "string", "minLength": 5}}}],
   "description": "M only (frozen before generation; section 10.1); null for R and A"},
  "naive_path": {"anyOf": [{"type": "null"}, {"const": "naive.py"}], "description": "M only"},
  "reference_path": {"const": "reference.py"},
  "so_question_id": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
  "so_url": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^https://stackoverflow\\.com/q/[0-9]+$"}]},
  "so_creation_date": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"}]},
  "so_score": {"anyOf": [{"type": "null"}, {"type": "integer"}]},
  "so_licence": {"anyOf": [{"type": "null"}, {"const": "CC BY-SA 4.0"}]},
  "intent_summary": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 10}]},
  "column_map": {"anyOf": [{"type": "null"}, {"type": "object"}],
                 "description": "R only: question column/role -> fixture 'file.csv:column' chosen by the section 4.3 type table"},
  "invitation_strength": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 3}],
                          "description": "filled by INTEGRATE from BLIND phase 3 (M only)"},
  "invited_ids_reviewer": {"anyOf": [{"type": "null"}, {"type": "array", "items": {"$ref": "#/$defs/catalogue_id"}}],
                           "description": "filled from BLIND phase 2 (all strata; required non-null for R and A at freeze)"},
  "fidelity": {"anyOf": [{"type": "null"},
                         {"type": "object", "additionalProperties": false, "required": ["result", "reason"],
                          "properties": {"result": {"enum": ["PASS", "FAIL"]}, "reason": {"type": "string"}}}],
               "description": "R only, from BLIND phase 1c"},
  "independent_card_ref": {"anyOf": [{"type": "null"}, {"type": "string"}],
                           "description": "path of the blind independent card (review_blind/phase1/<blind_id>.json) if sampled"},
  "blind_provenance": {"anyOf": [{"type": "null"}, {"const": "LLM-assisted"}]},
  "drafted_by": {"type": "string", "pattern": "^(pkg:[A-Z0-9_]+|author)$"},
  "status": {"type": "string", "minLength": 5,
             "description": "label of the preparation workflow"},
  "notes": {"type": "string"}
 },
 "$defs": {
  "catalogue_id": {"type": "string",
                   "pattern": "^(S0[1-6]|O01|D(0[1-9]|10)|C0[1-6]|G0[1-8]|R0[1-7]|N0[1-7]|I0[1-6]|X0[1-2]|L0[1-6])$"},
  "property_check": {
   "type": "object", "additionalProperties": false, "required": ["check", "args"],
   "properties": {
    "check": {"enum": ["no_null_text", "no_all_missing_column", "date_year_in_range", "counts_sum_to_rows",
                       "rate_in_unit_interval", "n_groups_equals", "no_nulls", "numeric_in_range", "values_in_set",
                       "columns_present", "result_kind", "sorted_by"]},
    "args": {"type": "object"}}}
 }
}
