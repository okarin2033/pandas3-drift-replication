{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pandas3_full/conventions/schema/run_record.schema.json",
 "title": "One run of one program in one run config (written by HRUN's runner_full.py / run_programs.py)",
 "$comment": "Written 2026-11-11 by pkg:SHARED. Implements FULL_PREREG sections 3 and 6 and PILOT_PREREG section 7 (record fields). Stored gzip-compressed at <runs_root>/<run_config>/<program_id>.json.gz; the canonical result and the trace are separate files (paths below) so records stay small. Extra keys are allowed (additionalProperties true) so HRUN may add diagnostics; the keys listed here are required with these meanings.",
 "type": "object",
 "additionalProperties": true,
 "required": ["schema_version", "program_id", "run_config", "config", "fixture_variant", "venv", "mode", "hash_seed",
              "versions", "options", "status", "result_path", "result_sha256", "result_type", "warnings", "n_warnings",
              "warning_filter_calls_neutralised", "stdout_sha256", "files_written", "wall_s", "cpu_s", "max_rss_bytes",
              "exc_type", "exc_msg", "exc_user_line", "trace_path", "trace_truncated", "started_at"],
 "properties": {
  "schema_version": {"const": "run_record/1"},
  "program_id": {"type": "string", "pattern": "^[A-Za-z0-9_.\\-]+(/[A-Za-z0-9_.\\-]+)*$",
                 "description": "conventions section 3.4, e.g. gen/qwen35_9b/M_QF1_01__s0, naive/M_QF1_01, ref/R_03, confirm/S01"},
  "task_id": {"anyOf": [{"type": "null"}, {"type": "string"}]},
  "run_config": {"type": "string", "pattern": "^((E0a|E0b|E1|E2|E0pa|E3|E4|A1|A2|A3|A4|T0|T1|T2|C1)|V-(clean|dirty)__(E0a|E0b|E1))$",
                 "description": "config id incl. fixture variant prefix for V runs (conventions section 4)"},
  "config": {"enum": ["E0a", "E0b", "E1", "E2", "E0pa", "E3", "E4", "A1", "A2", "A3", "A4", "T0", "T1", "T2", "C1"],
             "description": "base config (environment + mode + hash seed)"},
  "fixture_variant": {"enum": ["main", "clean", "dirty"]},
  "venv": {"enum": ["pd233", "pd31x", "pd30x", "pd233pa", "pd31xpa", "pd30xpa", "pd223"]},
  "mode": {"enum": ["base", "cow", "str", "both", "stroff", "trace"]},
  "hash_seed": {"type": "integer", "minimum": 0},
  "versions": {"type": "object", "required": ["python", "pandas", "numpy", "pyarrow", "dateutil", "tzdata"],
               "properties": {"python": {"type": "string"}, "pandas": {"type": "string"}, "numpy": {"type": "string"},
                              "pyarrow": {"anyOf": [{"type": "null"}, {"type": "string"}]},
                              "dateutil": {"anyOf": [{"type": "null"}, {"type": "string"}]},
                              "tzdata": {"anyOf": [{"type": "null"}, {"type": "string"}]}}},
  "options": {"type": "object", "description": "values of mode.copy_on_write and future.infer_string as str, 'n/a' if absent"},
  "status": {"enum": ["ok", "no_result", "error", "timeout", "cpu_limit", "memory_limit", "crash", "canon_error",
                      "harness_error"],
             "description": "completion status; LOUD = error|timeout|cpu_limit|memory_limit|crash; no_result = completed without `result`"},
  "result_path": {"anyOf": [{"type": "null"}, {"type": "string"}],
                  "description": "canonical result file (JSON, gz) relative to runs_root; null unless status ok"},
  "result_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}],
                    "description": "sha256 of the canonical result JSON (uncompressed, sort_keys, separators (',', ':'))"},
  "result_type": {"anyOf": [{"type": "null"}, {"type": "string"}],
                  "description": "module.qualname of type(result); compared WITHOUT module path (pilot CHANGES 23:47)"},
  "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"},
               "description": "distinct warnings (first 200 distinct keys), each with a count"},
  "n_warnings": {"type": "integer", "minimum": 0},
  "warning_filter_calls_neutralised": {"type": "integer", "minimum": 0},
  "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "stdout_tail": {"type": "string", "description": "last 20000 characters (optional)"},
  "files_written": {"type": "object",
                    "description": "basename -> {sha256, size, fixture_modified, rows? (CSV, first 5000 rows)}; untouched fixtures omitted"},
  "wall_s": {"type": "number", "minimum": 0},
  "cpu_s": {"anyOf": [{"type": "null"}, {"type": "number", "minimum": 0}]},
  "max_rss_bytes": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
  "exc_type": {"anyOf": [{"type": "null"}, {"type": "string"}]},
  "exc_msg": {"anyOf": [{"type": "null"}, {"type": "string"}]},
  "exc_user_line": {"anyOf": [{"type": "null"}, {"type": "integer"}]},
  "trace_path": {"anyOf": [{"type": "null"}, {"type": "string"}],
                 "description": "T0/T1/T2 only: trace file relative to runs_root (format: conventions section 4.3)"},
  "trace_truncated": {"anyOf": [{"type": "null"}, {"type": "boolean"}], "description": "null outside trace configs"},
  "started_at": {"type": "string", "description": "ISO 8601 with offset"},
  "harness_sha256": {"type": "string", "description": "sha256 over child_full.py + sandbox_full.sb (optional)"}
 },
 "$defs": {
  "warning": {
   "type": "object", "additionalProperties": true,
   "required": ["category_qualname", "category_module", "mro", "message", "filename", "lineno", "user_line",
                "pandas_on_stack", "phase", "count"],
   "properties": {
    "category_qualname": {"type": "string", "description": "e.g. FutureWarning, Pandas4Warning"},
    "category_module": {"type": "string", "description": "e.g. builtins, pandas.errors"},
    "mro": {"type": "array", "items": {"type": "string"}, "description": "module.qualname of every class in the MRO"},
    "message": {"type": "string", "description": "first 300 characters"},
    "filename": {"anyOf": [{"type": "null"}, {"type": "string"}], "description": "as reported by warnings (not used for the definition)"},
    "lineno": {"anyOf": [{"type": "null"}, {"type": "integer"}]},
    "user_line": {"anyOf": [{"type": "null"}, {"type": "integer"}], "description": "innermost prog.py line on the stack"},
    "pandas_on_stack": {"type": "boolean"},
    "phase": {"enum": ["import", "setup", "user", "post"]},
    "count": {"type": "integer", "minimum": 1}}}
 }
}
